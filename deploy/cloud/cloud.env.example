# Copy to .env.cloud (ignored), chmod 600. No shared demo token is used by cloud serve.
BASE_URL=https://mcp.contexto.example.com
REPOLEAD_MCP_DOMAIN=mcp.contexto.example.com
# Copy the EXACT corporate issuer from tickets-portal, including /realms/<realm>.
AUTH_OIDC_ISSUER_URL=https://sso.example.com/realms/wlt

# Local publisher: connect to PG through a private network/VPN or SSH tunnel.
REPOLEAD_PG_PUBLISH_URL=postgresql://repolead_owner:CHANGE_OWNER_PASSWORD@127.0.0.1:5438/repolead
# Cloud MCP: repolead_app cannot read captured-source blobs or mirror rows.
REPOLEAD_PG_READ_URL=postgresql://repolead_app:CHANGE_APP_PASSWORD@postgres:5432/repolead
# Local worker: private connection to the cloud PG instance.
REPOLEAD_PG_WORKER_URL=postgresql://repolead_worker:CHANGE_WORKER_PASSWORD@127.0.0.1:5438/repolead
REPOLEAD_VECTOR_BACKEND=pgvector
REPOLEAD_PG_LOCAL_URL=postgresql://repolead_owner:CHANGE_OWNER_PASSWORD@127.0.0.1:5438/repolead
REPOLEAD_LOCAL_PG_TLS=disable

# verify-full for managed/cloud TCP connections. disable only for loopback SSH tunnels or the private Compose network.
REPOLEAD_PG_TLS=disable
REPOLEAD_WORKER_PG_TLS=disable
# Optional custom CA path when using the CLI: REPOLEAD_PG_CA_FILE=/private/ca.pem
REPOLEAD_OWNER_PASSWORD=CHANGE_OWNER_PASSWORD
REPOLEAD_APP_PASSWORD=CHANGE_APP_PASSWORD
REPOLEAD_WORKER_PASSWORD=CHANGE_WORKER_PASSWORD
REPOLEAD_PG_LOCAL_PORT=5438
REPOLEAD_MCP_LOCAL_PORT=3939
REPOLEAD_ALLOWED_ORIGINS=https://claude.ai,https://claude.com
REPOLEAD_QDRANT_URL=http://127.0.0.1:6333
REPOLEAD_TEI_URL=http://127.0.0.1:8082
REPOLEAD_RESEARCH_OLLAMA_URL=http://127.0.0.1:11434
REPOLEAD_RESEARCH_MODEL=qwen3.5:9b-q4_K_M
